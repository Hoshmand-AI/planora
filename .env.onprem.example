# Planora on-premises settings for docker-compose.yml. Copy to .env (never commit it) and fill in.
# Generate secrets with:  openssl rand -base64 48
# Every variable the application reads is described in docs/operations/ON-PREM-INSTALL.md.

# Required
POSTGRES_PASSWORD=
JWT_SECRET=
PLANORA_ENCRYPTION_KEY=
APP_URL=https://planora.example.internal

# Image tag to run (docker load'ed from the release bundle)
PLANORA_VERSION=local

# AI: offline (default, no model) or local (an on-prem OpenAI-compatible server)
PLANORA_AIRGAPPED=true
PLANORA_AI_MODE=offline
# LLM_BASE_URL=http://gpu01.enclave.internal:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=
# PLANORA_ALLOWED_HOSTS=
# PLANORA_APPROVED_MODELS=

# Plan entitlements for new organizations (free | pro | enterprise), per your licence terms
PLANORA_DEFAULT_PLAN=free

# invite_only (default here): after the first owner signs up, new accounts need an invitation
PLANORA_SIGNUP=invite_only

# Where the app listens on the host (keep loopback when a reverse proxy runs on the same host)
# PLANORA_BIND=127.0.0.1
# PLANORA_PORT=3000

# A private CA for an on-prem identity provider or model host: see NODE_EXTRA_CA_CERTS in docker-compose.yml.
