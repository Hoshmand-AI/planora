# Planora — Environment Variables

# Postgres (Neon in the cloud; any Postgres 14+ on-prem). TLS is skipped for localhost / PGSSLMODE=disable.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# JWT secret — required in production (the app refuses to start auth without it)
JWT_SECRET=change-me

# ── AI processing ───────────────────────────────────────────────
# cloud | local | offline. Default: cloud if ANTHROPIC_API_KEY or OPENAI_API_KEY is set, else offline.
# Cloud AI sends request-relevant content (never withheld answers or CUI/classified projects) to the selected provider.
# Everything (interview, generation, CPM, DCMA, evaluation, exports) works offline;
# a model only adds follow-up questions and narrative Q&A/reports.
# PLANORA_AI_MODE=cloud
# Cloud provider: anthropic | openai. Default: anthropic when ANTHROPIC_API_KEY is set, otherwise openai when OPENAI_API_KEY is set.
# PLANORA_AI_PROVIDER=anthropic
# Anthropic (Claude) — the default cloud provider (default model claude-opus-5-5)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# OpenAI — approved alternate cloud provider (default model gpt-4o-2024-11-20)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# On-prem / self-hosted model (OpenAI-compatible: Ollama, vLLM, llama.cpp server, TGI)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=

# Air-gapped deployments (e.g. DoD / classified work): refuses cloud AI and any model host
# that is not loopback / private-network / *.local / *.internal, or listed below.
# PLANORA_AIRGAPPED=true
# PLANORA_ALLOWED_HOSTS=llm.enclave.example

# ── Security & governance ───────────────────────────────────────
# Encrypts MFA and SSO secrets at rest (32+ random characters). Defaults to a key derived from JWT_SECRET.
# Set it once before anyone enrolls in two-step verification; changing it later requires re-enrollment.
# PLANORA_ENCRYPTION_KEY=
# Plan for organizations created from now on: free | pro | enterprise (default free). See src/lib/server/entitlements.ts
# PLANORA_DEFAULT_PLAN=free
# Ceiling for each organization's AI requests per day (admins can set lower; plans cap it too)
# PLANORA_AI_DAILY_LIMIT=300
# Approved, version-pinned models (comma-separated). Default list: docs/ai/MODEL-REGISTRY.md
# PLANORA_APPROVED_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# Private CA for an on-prem database (TLS is always verified for remote databases)
# PGSSLROOTCERT=/etc/ssl/certs/db-ca.pem
# Database pool size per instance
# PG_POOL_MAX=10
# Tests only: allow http:// OIDC issuers and *.example SSO domains without DNS verification
# PLANORA_ALLOW_INSECURE_OIDC=1
# On-premises: new accounts only by invitation after the first (bootstrapping) owner
# PLANORA_SIGNUP=invite_only
# Where this instance runs: commercial (default) | onprem. See docs/operations/ON-PREM-INSTALL.md
# PLANORA_DEPLOYMENT=onprem
